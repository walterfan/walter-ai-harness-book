#: e0d2136fae4449579086eeb46eddf7bd
msgid "Slide 23 —— §F.8 · 常见问 Q1"
msgstr ""

#: ../../source/part0-presentation/slides.md:319
#: d7ab718c5d4b47deb1ee8d829cf1fcc6
msgid "Q：**跟 CI 流水线有什么区别？**"
msgstr ""

#: ../../source/part0-presentation/slides.md:320
#: 7fb5727e16744e9294acd823c10030a6
msgid "A：CI 是 TDD / MDD 的 **牧场**"
msgstr ""

#: ../../source/part0-presentation/slides.md:321
#: 7b1efdf8e11f4b239a7545b3c2cacffb
msgid "合入那一刻发声"
msgstr ""

#: ../../source/part0-presentation/slides.md:322
#: 09a6919592c24e17a0849cb906c98808
msgid "Harness 在 **键盘按下那一刻** 发声"
msgstr ""

#: ../../source/part0-presentation/slides.md:324
#: b70453df84eb4d1b8de3343af15768a7
msgid ""
"60–90 秒。如果听众追问 *\"那我们把 CI 加个 pre-commit 不就行了？\"* —— 回答 *\"那就是 Fence。你已经在做"
" harness 了，只是还没意识到。\"*"
msgstr ""

#: ../../source/part0-presentation/slides.md:329
#: cc8291a9314140c2b60fe1d6ec9fdc21
