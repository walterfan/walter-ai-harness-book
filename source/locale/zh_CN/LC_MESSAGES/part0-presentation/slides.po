#: ../../source/part0-presentation/slides.md:112
#: 2097742f4085481f927524d9585cdfc1
msgid "Slide 8 —— §F.2 · 一句话定义"
msgstr ""

#: ../../source/part0-presentation/slides.md:114
#: 53b2f17afcfb4c6eb9f71b2d801a9d6c
msgid "Harness Engineering ="
msgstr ""

#: ../../source/part0-presentation/slides.md:115
#: 08e90c595ccc4db387cbfb6548e602c0
msgid "**刻意设计、运行、演化**"
msgstr ""

#: ../../source/part0-presentation/slides.md:116
#: f864f96596f84b6099ac49a4e3533af5
msgid "AI 编码智能体**周围的结构**"
msgstr ""

#: ../../source/part0-presentation/slides.md:117
#: 95a729c42f2a41ceab57730decff497e
msgid "目的：让产出 **可验证 / 可观测 / 可理解**"
msgstr ""

#: ../../source/part0-presentation/slides.md:119
#: d5f63081922540daab18f3e82f8e5755
msgid "可验证 / 可观测 / 可理解三词竖着写在白板左栏，停 3 秒再说 —— *\"这三词不是修辞。每一个背后都有一门四十年历史的工程学科。\"*"
msgstr ""

#: ../../source/part0-presentation/slides.md:124
#: 2900a45b6ab549dba39f74e74e610b38
msgid "Slide 9 —— §F.2 · 是 × 5"
msgstr ""

#: ../../source/part0-presentation/slides.md:126
#: 4c7af7c975684b67babee674f4ce3c05
msgid "面向智能体的规约（`CLAUDE.md`/`AGENTS.md`/`SKILL.md`/MCP manifest）"
msgstr ""

#: ../../source/part0-presentation/slides.md:127
#: d675600338c84c43bd5e14a57cab2a0f
msgid "审批门与护栏（pre-commit / lint / PR review / CI）"
