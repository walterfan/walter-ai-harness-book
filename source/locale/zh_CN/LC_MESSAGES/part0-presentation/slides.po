msgstr ""

#: ../../source/part0-presentation/slides.md:95
#: bfca08681df0469cadf5ff92d3b3b48c
msgid "Harness：**仓库本身** —— `CLAUDE.md` + 护栏 + 钩子 + 巡检"
msgstr ""

