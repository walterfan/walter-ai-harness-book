#: ../../source/part0-presentation/slides.md:226
#: 203af7f9bf544da0a272687c5a382c01
msgid "**lazy-scrum-team** —— 把 Scrum 角色与交接当挽具"
msgstr ""

#: ../../source/part0-presentation/slides.md:227
#: de134ed0e8f6467e80da2b76cdfca138
