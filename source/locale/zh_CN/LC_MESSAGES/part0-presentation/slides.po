#: 36dc7c39949c402fbed1424c1ddb06a3
msgid "Slide 16 —— §F.5 · 每案一句"
msgstr ""

#: ../../source/part0-presentation/slides.md:224
#: 00c50b244f4c4ae0ba48250570660421
msgid "**OpenHarness** —— 唯一\"读过第 05 章才写的\"开源参考实现"
msgstr ""

#: ../../source/part0-presentation/slides.md:225
