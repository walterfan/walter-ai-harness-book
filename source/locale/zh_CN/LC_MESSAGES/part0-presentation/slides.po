#: 3c31e59f062745a792c5f2a5ccc67e73
msgid "**快念**。每条 10 秒。重点不在记住每条，而在听众形成 *\"原来 harness 的范围是这些东西\"* 的整体印象。"
msgstr ""

#: ../../source/part0-presentation/slides.md:137
#: 6eea3b6414fc4260aa56f95f3efbe8d8
msgid "Slide 10 —— §F.2 · 不是 × 5"
msgstr ""

#: ../../source/part0-presentation/slides.md:139
#: c948280c14c5476eb9df94ef59793c39
msgid "**不是** 推理运行栈（AI Engineering）"
msgstr ""

#: ../../source/part0-presentation/slides.md:140
#: 4ca7ceb241c547d8bbb1dc63718fcc1e
msgid "**不是** ML 评测基准"
msgstr ""

#: ../../source/part0-presentation/slides.md:141
#: 7f0f1a01ce814968a398d1146893f6bc
msgid "**不是** IDE 插件（Cursor / Copilot 是客户端）"
msgstr ""

#: ../../source/part0-presentation/slides.md:142
#: db8d2ad0e50443d8a8350694e5100017
msgid "**不是** Agent 框架 SDK（LangChain / AutoGen）"
msgstr ""

#: ../../source/part0-presentation/slides.md:143
#: 7bbbdd0c91d84e1e82b8cb846d77815a
msgid "**不是** 部署流水线（DevOps）"
msgstr ""

#: ../../source/part0-presentation/slides.md:145
#: b84e784354064db09b1928fc5b427495
msgid ""
"比\"是\"还要快。每条 8 秒。 关键在于收尾那句 **归属检验** —— *\"commit 之前 = harness；commit 之后 ="
" DevOps。\"*"
msgstr ""

#: ../../source/part0-presentation/slides.md:151
#: 9a9ef77d95a9452ea78fbb1c2f7cd336
msgid "Slide 11 —— §F.3 · 因果顺序反转"
