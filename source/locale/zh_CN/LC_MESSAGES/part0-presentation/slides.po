#: 243b3f55a013435e843c8ba351e4c22b
msgid "每条 15 秒，一共 45 秒。念完之后加一句 —— *\"三件事的共性是 —— 他们变的都不是模型，是模型周围的东西。\"*"
msgstr ""

#: ../../source/part0-presentation/slides.md:78
#: 1d6169f6740c4e10a54839e07cb46216
msgid "Slide 5 —— §F.1 · 四阶段演化"
msgstr ""

