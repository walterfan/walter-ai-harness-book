#: ../../source/chapters/09-lazy-scrum-team.md:117
#: e73ecac8b45f4dcdb8ea4c0e3b9002c2
#, python-brace-format
msgid ""
"The Humble & Farley *Continuous Delivery* lineage "
"{cite}`humble2010continuousdelivery` supplies the Hard-gate grammar; the "
"DORA metrics literature {cite}`forsgren2018accelerate` shows why the ratio "
"of Soft-gate waivers to Hard-gate passes is itself a health signal."
msgstr ""
