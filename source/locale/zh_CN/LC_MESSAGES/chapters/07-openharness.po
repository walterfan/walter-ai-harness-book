msgstr "`mcp/` —— MCP 客户端接线；工具使用的那条通道。"

#: ../../source/chapters/07-openharness.md:36 72b875e7a3c043d5b340721add774960
msgid "`memory/` — conversation memory manager."
msgstr "`memory/` —— 会话记忆管理器。"

#: ../../source/chapters/07-openharness.md:37 107ad052cdf84b1aae42cf6f70ed1308
