#: bb9cec207c7e4b37bfd47eaf6b16d04e
msgid ""
"Act 4's reproducibility claim rests on a short shell script that runs the "
"three new make targets against a fresh clone at the Act-4 SHA:"
msgstr "第四幕的可复现性主张，建立在一段简短 shell 脚本之上——它针对\"第四幕 SHA\"处的一份全新 clone，跑三个新的 make 目标："

#: ../../source/chapters/11-lazy-ai-coder.md:188
#: 086da81d34b24532836d4727cac5acbb
msgid ""
"#!/usr/bin/env bash\n"
"# verified: 2026-04-17 · Ch.11 hands-on · reproduce the HarnessCard delta\n"
"# Run from a fresh clone of walterfan/lazy-ai-coder at the Act-4 SHA.\n"
"set -euo pipefail\n"
"\n"
"# 1. SDD × Fence — prompts-lint validates config/prompts.yaml\n"
"make prompts-lint\n"
"\n"
"# 2. TDD × Fence — MCP tool schema-vs-handler consistency check\n"
"make mcp-schema-check\n"
"\n"
"# 3. TDD × Fence — pre-commit hooks refuse secrets\n"
"make secrets-check\n"
"\n"
"echo \"If all three targets exited 0, the harness is at its Act-4 score.\"\n"
msgstr ""
"#!/usr/bin/env bash\n"
"# verified: 2026-04-17 · Ch.11 hands-on · reproduce the HarnessCard delta\n"
"# Run from a fresh clone of walterfan/lazy-ai-coder at the Act-4 SHA.\n"
"set -euo pipefail\n"
"\n"
"# 1. SDD × Fence — prompts-lint validates config/prompts.yaml\n"
"make prompts-lint\n"
"\n"
"# 2. TDD × Fence — MCP tool schema-vs-handler consistency check\n"
"make mcp-schema-check\n"
"\n"
"# 3. TDD × Fence — pre-commit hooks refuse secrets\n"
"make secrets-check\n"
"\n"
"echo \"If all three targets exited 0, the harness is at its Act-4 score.\"\n"

